@page "/"

<PageTitle>Inicio</PageTitle>

<div class="text-center mt-5">
    <h1 class="display-4">Prueba Técnica - CRUD de Productos</h1>
    <p class="lead mt-3">Sistema de gestión de productos con ASP.NET Core 9 y Blazor Server</p>
    
    <div class="mt-4">
        <a href="/productos" class="btn btn-primary btn-lg">
            <span class="bi bi-box-seam me-2"></span>
            Ver Productos
        </a>
    </div>

    <div class="row mt-5">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="bi bi-database me-2"></span>
                        Base de Datos
                    </h5>
                    <p class="card-text">SQL Server LocalDB con Entity Framework Core</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="bi bi-code-slash me-2"></span>
                        Tecnologías
                    </h5>
                    <p class="card-text">.NET 9, Blazor Server, API REST</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <span class="bi bi-check-circle me-2"></span>
                        Funcionalidades
                    </h5>
                    <p class="card-text">CRUD completo con validaciones y soft delete</p>
                </div>
            </div>
        </div>
    </div>
</div>
