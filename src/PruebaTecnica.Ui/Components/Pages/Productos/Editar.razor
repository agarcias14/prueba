@page "/productos/editar/{Id:int}"
@rendermode InteractiveServer
@using PruebaTecnica.Ui.Services
@inject PruebaTecnica.Ui.Services.ProductosApiService Api
@inject NavigationManager Nav

<h3>Editar Producto</h3>

@if (cargando)
{
    <p>Cargando...</p>
}
else if (noEncontrado)
{
    <div class="alert alert-danger">Producto no encontrado.</div>
    <button class="btn btn-secondary" @onclick="Volver">Volver</button>
}
else
{
    <EditForm Model="model" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-2">
            <label>Código</label>
            <InputText class="form-control" @bind-Value="model.Codigo" />
        </div>

        <div class="mb-2">
            <label>Nombre</label>
            <InputText class="form-control" @bind-Value="model.Nombre" />
        </div>

        <div class="mb-2">
            <label>Precio</label>
            <InputNumber class="form-control" @bind-Value="model.Precio" />
        </div>

        <div class="mb-2">
            <label>Stock</label>
            <InputNumber class="form-control" @bind-Value="model.Stock" />
        </div>

        <div class="mb-2 form-check">
            <InputCheckbox class="form-check-input" @bind-Value="model.Activo" />
            <label class="form-check-label ms-1">Activo</label>
        </div>

        <button class="btn btn-warning" type="submit" disabled="@guardando">Guardar cambios</button>
        <button class="btn btn-secondary ms-2" type="button" @onclick="Volver">Cancelar</button>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert alert-warning mt-2">@mensaje</div>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private ProductoUpdateDto model = new();
    private bool cargando = true;
    private bool noEncontrado = false;
    private bool guardando = false;
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var dto = await Api.GetByIdAsync(Id);
            if (dto is null)
            {
                noEncontrado = true;
                return;
            }

            // Cargar valores actuales
            model.Codigo = dto.Codigo;
            model.Nombre = dto.Nombre;
            model.Precio = dto.Precio;
            model.Stock = dto.Stock;
            model.Activo = dto.Activo;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Guardar()
    {
        guardando = true;
        mensaje = null;

        var ok = await Api.UpdateAsync(Id, model);
        if (!ok)
        {
            mensaje = "No se pudo actualizar. Verifica código duplicado o datos inválidos.";
            guardando = false;
            return;
        }

        Nav.NavigateTo("/productos");
    }

    private void Volver() => Nav.NavigateTo("/productos");
}