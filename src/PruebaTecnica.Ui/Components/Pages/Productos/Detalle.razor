@page "/productos/{Id:int}"
@rendermode InteractiveServer
@using PruebaTecnica.Ui.Services
@inject PruebaTecnica.Ui.Services.ProductosApiService Api
@inject NavigationManager Nav

<h3>Detalle de Producto</h3>

@if (cargando)
{
    <p>Cargando...</p>
}
else if (producto is null)
{
    <div class="alert alert-danger">Producto no encontrado.</div>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@producto.Id</dd>

        <dt class="col-sm-2">Código</dt>
        <dd class="col-sm-10">@producto.Codigo</dd>

        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@producto.Nombre</dd>

        <dt class="col-sm-2">Precio</dt>
        <dd class="col-sm-10">@producto.Precio</dd>

        <dt class="col-sm-2">Stock</dt>
        <dd class="col-sm-10">@producto.Stock</dd>

        <dt class="col-sm-2">Activo</dt>
        <dd class="col-sm-10">@((producto.Activo) ? "Sí" : "No")</dd>

        <dt class="col-sm-2">Creado</dt>
        <dd class="col-sm-10">@producto.CreatedAt</dd>

        <dt class="col-sm-2">Actualizado</dt>
        <dd class="col-sm-10">@producto.UpdatedAt</dd>
    </dl>

    <button class="btn btn-secondary" @onclick="Volver">Volver</button>
    <button class="btn btn-warning ms-2" @onclick="Editar">Editar</button>
}

@code {
    [Parameter] public int Id { get; set; }
    private bool cargando = true;
    private ProductoDto? producto;

    protected override async Task OnInitializedAsync()
    {
        producto = await Api.GetByIdAsync(Id);
        cargando = false;
    }

    private void Volver() => Nav.NavigateTo("/productos");
    private void Editar() => Nav.NavigateTo($"/productos/editar/{Id}");
}